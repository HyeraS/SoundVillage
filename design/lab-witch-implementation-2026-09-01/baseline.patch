-// 비대칭 덩어리 조합: 낮은 측면 윙 + 본체 + 타워 베이
-function drawBuilding(ctx, b, on) {
-  const x = b.x * T, y = b.y * T, w = b.w * T, h = b.h * T;
-  const side = (b.x % 2 === 0) ? 'l' : 'r';           // 타워 위치를 건물마다 다르게
-  const towerW = 58;
