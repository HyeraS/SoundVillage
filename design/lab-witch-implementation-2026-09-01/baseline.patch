-
-  // ---- 아치창 배열 (타워 쪽은 비워둔다)
-  const zoneX = side === 'l' ? x + towerW - 6 : x + 14;
-  const zoneW = w - towerW - 8;
-  const cols = zoneW > 130 ? 3 : 2;
-  const rows = wallH > 118 ? 2 : 1;
-  const cw = zoneW / cols;
-  for (let r = 0; r < rows; r++)
-    for (let c = 0; c < cols; c++) {
-      const wx = zoneX + c * cw + (cw - 24) / 2;
