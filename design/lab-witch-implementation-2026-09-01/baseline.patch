-  px(ctx, x - 3, y + h - 16, w + 6, 3, b.wallLit);
-  for (let i = 0; i < w + 6; i += 14) px(ctx, x - 3 + i, y + h - 16, 1, 16, 'rgba(20,16,48,0.3)');
