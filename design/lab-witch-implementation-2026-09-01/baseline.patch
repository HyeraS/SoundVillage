-
-  // ---- 타워 베이 (본체보다 높고 앞으로 튀어나온다)
-  const tx = side === 'l' ? x - 10 : x + w - towerW + 10;
-  const towerTop = y + 4;
-  px(ctx, tx, towerTop, towerW, y + h - towerTop, b.wallLit);
