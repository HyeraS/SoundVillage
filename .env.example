NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only. Configure only in the Next.js server/deployment environment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal routes remain disabled unless both local development and this exact flag are used.
ENABLE_INTERNAL_TEST_ROUTES=false
