NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Public base directory containing <Zone>/<audio-id>.mp3. Do not include a trailing slash.
# Example:
# https://your-project.supabase.co/storage/v1/object/public/audio
# Leave blank in local development to use /audio.
NEXT_PUBLIC_AUDIO_BASE_URL=

# Server-only. Configure only in the Next.js server/deployment environment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only, random, and at least 32 characters. Never expose as NEXT_PUBLIC_*.
MULTI_VILLAGE_ECONOMY_HMAC_SECRET=replace-with-a-random-32-plus-character-secret
# Server-only. Allowed values: legacy, preview, cutover. Missing/invalid means legacy.
SOUNDVILLAGE_ECONOMY_MODE=legacy

# Internal routes remain disabled unless both local development and this exact flag are used.
ENABLE_INTERNAL_TEST_ROUTES=false
